# ---------------------------------------------------------------------------
# OpenCode Web Chat - variables de entorno
# Copia este archivo a .env para desarrollo local.
# ---------------------------------------------------------------------------

# Entorno: development | production
NODE_ENV=development

# Puerto donde escucha el backend Express (Render lo inyecta con PORT)
PORT=3001

# ---------------------------------------------------------------------------
# Secretos
# ---------------------------------------------------------------------------
# Firma de los JWT (cualquier cadena larga y aleatoria).
# Si no los defines, el backend genera JWT_SECRET y ENCRYPTION_KEY la primera
# vez y los guarda en <DATA_DIR>/secrets.json (disco persistente de Render).
# Definirlos como variables es lo recomendado para controlarlos tú.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Clave maestra para cifrar en reposo las API keys de los usuarios
ENCRYPTION_KEY=cambia-esto-por-otra-clave-larga-y-aleatoria

# ---------------------------------------------------------------------------
# Almacenamiento (disco persistente de Render montado en /data)
# ---------------------------------------------------------------------------
# Directorio raíz de datos. Por defecto /data en producción y <tmp>/opencode-web-chat en desarrollo.
# DATA_DIR=/data
DATABASE_PATH=./data/opencode.db
SKILLS_DIR=./data/skills
UPLOADS_DIR=./data/uploads

# ---------------------------------------------------------------------------
# Servidor de OpenCode
# ---------------------------------------------------------------------------
# URL de un servidor OpenCode ya existente. Si se deja vacío, el backend
# arranca automáticamente `opencode serve` como proceso hijo.
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# Contraseña del servidor (Basic auth: usuario "opencode", password esta clave)
# OPENCODE_SERVER_PASSWORD=secreto-del-servidor
# Arrancar automáticamente `opencode serve` si no hay OPENCODE_BASE_URL
OPENCODE_AUTOSTART=true
# Puerto interno del servidor OpenCode
OPENCODE_PORT=4096
# Directorio de trabajo/proyecto que OpenCode usa como "location"
OPENCODE_DIRECTORY=./data/workspace
# Ruta del binario de opencode (por defecto se resuelve en el PATH)
# OPENCODE_BIN=opencode
# Modelo por defecto (providerID/modelID). Ver /api/models.
OPENCODE_DEFAULT_MODEL=opencode-go/deepseek-v4.1-flash
# Agente por defecto
OPENCODE_DEFAULT_AGENT=build

# ---------------------------------------------------------------------------
# CORS: orígenes permitidos separados por coma (vacío = mismo origen / *)
# ---------------------------------------------------------------------------
CORS_ORIGINS=
